public class basic_array {
    public static void main(String[] args){int[] arr = {2, 50, 48, 3, 7, 57};
        int max = arr[0];
        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > max) {
                max = arr[i];
            }
        }
            System.out.println(" maximum = " + max);
        }
    }
