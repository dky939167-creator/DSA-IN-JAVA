// check whether a number is palindrome or not
public class main{
public static void main(String args[]);
int num=121;
int original=num;
int reverse=0;
while(num>0){
  int rem =num%10;
  reverse =reverse*10 + rem;
  num = num/10;
}
if(original ==   reverse){
  System.out.println("pallindrom is =" +reverse);
}
else{
  System.out.println("not a pallindrome="+reverse);
}
}
}

 
